# ==============================================================================
# FAITHFEST ENVIRONMENT CONFIGURATION (.env.example)
# Interactive Religious Festival & Cultural Heritage Explorer
# Covering 82 Festivals, 52 Sacred Sites across Hinduism, Islam, & Christianity
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & NETWORK CONFIGURATION
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & JWT SECURITY
# ------------------------------------------------------------------------------
# Secure random string used to sign explorer & administrator JWT tokens.
# In production, generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=faithfest-secure-jwt-secret-key-change-in-production

# ------------------------------------------------------------------------------
# 3. SUPABASE CLOUD (POSTGRESQL) DATABASE INTEGRATION
# ------------------------------------------------------------------------------
# Connects to your hosted Supabase PostgreSQL database tables:
# (religions, festivals, foods, clothing, music_dance, decorations, symbols,
#  festival_locations, festival_location_relations, calendar_events, users)
SUPABASE_URL=https://zyqnbvzornaceomokfyd.supabase.co
SUPABASE_ANON_KEY=sb_publishable_d61_1LBBbSoBgT6SYkAuwA_pkoUQ_kY

# Optional Service Role Secret (Admin/Migrations only - NEVER expose in client bundles)
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_here

# ------------------------------------------------------------------------------
# 4. AI CULTURAL HERITAGE GUIDE & LLM PROVIDER SETTINGS
# ------------------------------------------------------------------------------
# The FaithFest AI Guide is grounded in verified cultural heritage data.
# When an API key is provided below, it connects to live LLM generative reasoning.
# If no API key is provided, the system gracefully falls back to the built-in
# offline RAG Knowledge Synthesizer (< 20ms latency) without failing.

# --- Google Gemini API (Recommended: High-speed, accurate multilingual reasoning) ---
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
# Alternative options: gemini-1.5-pro, gemini-2.0-flash

# --- OpenAI Fallback (Optional) ---
# Used automatically as secondary fallback if GEMINI_API_KEY is unset
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 5. RETRIEVAL-AUGMENTED GENERATION (RAG) & KNOWLEDGE ENGINE CONFIGURATION
# ------------------------------------------------------------------------------
# FaithFest's in-memory BM25 RAG engine indexes 804 verified heritage chunks:
#   • 82 Festival Overviews, Spiritual Significance, & Contemporary Celebrations
#   • 82 Historical Origin & Timeline records (Origins, Ancient, Medieval, Modern)
#   • 148 Traditional Festive Foods, Sacred Sweets, Ingredients, & Preparation
#   • Traditional Cultural Attire, Festive Clothing, & Garments
#   • Sacred Music, Dance Traditions, Hymns, & Folk Instruments
#   • Festive Decorations, Diyas, Ritual Objects, & Sacred Symbols
#   • 52 Mapped Sacred Pilgrimage Sites with GPS coordinates & Associated Festivals
#   • 2026/2027 Calendar Observances (Lunar months, tithis, variable dates)

# Number of top matching verified knowledge chunks to retrieve per query (default: 5)
RAG_TOP_K=5

# BM25 Term Frequency Saturation Parameter (default: 1.5, recommended: 1.2 - 2.0)
RAG_BM25_K1=1.5

# BM25 Document Length Normalization Parameter (default: 0.75, recommended: 0.6 - 0.9)
RAG_BM25_B=0.75

# Pre-warm & compile the in-memory BM25 index on server startup (< 20ms)
RAG_PREWARM_ON_STARTUP=true

# Fallback to zero-key high-fidelity response generator if API key or quota fails
AI_FALLBACK_SYNTHESIZER=true

# ------------------------------------------------------------------------------
# 6. MULTILINGUAL TRANSLATION & CULTURAL REVERENCE SAFEGUARDS
# ------------------------------------------------------------------------------
# Supported native languages with bidirectional entity cross-referencing:
# English, Telugu (తెలుగు), Hindi (हिन्दी), Tamil (தமிழ்)
SUPPORTED_LANGUAGES=English,Telugu,Hindi,Tamil

# Cultural Reverence & Neutrality Policy:
#   • Strict equal respect for Hinduism, Islam, and Christianity
#   • Answers strictly grounded in verified FaithFest catalog records
#   • Markdown source links formatted as [Festival Name](#/festival/ID)
#   • Zero debating, comparison, or ranking of religious faiths

# ------------------------------------------------------------------------------
# 7. GOOGLE OAUTH 2.0 (OPTIONAL EXPLORER ACCESS)
# ------------------------------------------------------------------------------
# Optional Google Client ID for One-Tap and Google Sign-in buttons
# Get your credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
